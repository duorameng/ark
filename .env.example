# ==============================================================================
#                      ⚓ Ark 班轮货运管理终端 - 部署配置环境样例
# ==============================================================================
# 使用说明：
# 1. 复制本文件重命名为 .env : cp .env.example .env
# 2. 根据您的部署环境填写以下参数
# 3. .env 文件已自动加入 .gitignore，不会被上传或泄露
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 默认交付港位目标 (可选: aliyun / github / both，未指定则根据已有配置自动识别)
# ------------------------------------------------------------------------------
# - 设为 "github" 或 "gh": 默认走 GitHub 镜像港口
# - 设为 "aliyun" 或 "ali": 默认走阿里云 ACR 国内极速港口
# - 设为 "both": 默认开启双推异地多活模式 (一次打包，同时交付两边)
# 命令行可随时使用参数临时切换: ark board ali / ark board gh / ark board both
ARK_TARGET="github"


# ------------------------------------------------------------------------------
# 2. 阿里云专用通道配置 (国内直连极速，永久免费 300 个仓库)
# ------------------------------------------------------------------------------
# 开启使用时填入您的阿里云信息:
# ALIYUN_REPOSITORY="registry.cn-hangzhou.aliyuncs.com/your_namespace/ark"
# ALIYUN_USERNAME="your_aliyun_username"       # 阿里云登录账号/手机号/RAM子账号
# ALIYUN_PASSWORD="your_aliyun_acr_password"   # 阿里云控制台设置的固定访问密码


# ------------------------------------------------------------------------------
# 3. GitHub 专用通道配置 (全球多机协同，官方 OCI 镜像注册表)
# ------------------------------------------------------------------------------
GITHUB_REPOSITORY="ghcr.io/duorameng/ark"
GH_TOKEN="ghp_YourGitHubPersonalAccessTokenHere123456"

# 通用兼容参数 (如果未配置上述通道，默认以此仓库为准)
ARK_REPOSITORY="ghcr.io/duorameng/ark"


# ------------------------------------------------------------------------------
# 4. 货运安全封条口令/密钥 (必选或推荐，用于全密闭加解密)
# ------------------------------------------------------------------------------
# 说明：所有数据离机前经 AES-256-CBC 强加密，云端仅存储密文，跨机器还原需此口令
ARK_SEAL_KEY="MyStrongVoyageSecret2026!#"


# ------------------------------------------------------------------------------
# 5. 业务分类标识 (建议多机器部署时各机器设置不同名称，彻底隔离版本)
# ------------------------------------------------------------------------------
# 默认值：vps
# 说明：生成标签为 {category}-{timestamp}；不同机器分开命名（如 vps-hk, vps-sg）可防互相覆盖
ARK_CATEGORY="vps"


# ------------------------------------------------------------------------------
# 6. 国内网络代理加速 (可选，国内机器直推 GitHub 遇到超时时配置)
# ------------------------------------------------------------------------------
# 支持 HTTP 代理或 SOCKS5 代理；配置后 OCI 直推与 API 交互全量走代理隧道
# ARK_PROXY="http://127.0.0.1:7890"
# ARK_PROXY="socks5://127.0.0.1:1080"


# ------------------------------------------------------------------------------
# 7. 待备份目录路径 (免 config.json 极速备份入口)
# ------------------------------------------------------------------------------
# 说明：
# - 支持配置单个目录: ARK_BACKUP_DIR="/root/workspace" 或 "./test_data"
# - 支持配置多个目录(逗号分隔): ARK_BACKUP_DIR="/data/web, /data/db"
ARK_BACKUP_DIR="/root/workspace"


# ------------------------------------------------------------------------------
# 8. 默认货物恢复落地路径 (可选，执行 ark land / unpack 时默认解封落地目录)
# ------------------------------------------------------------------------------
# 若配置了此项，运行 ark land 未传目标路径时，默认原位展开至该路径
# ARK_RESTORE_DIR="/root/workspace"


# ------------------------------------------------------------------------------
# 9. 备份保留个数配额 (严格控制历史航次数量，超出自动归档淘汰)
# ------------------------------------------------------------------------------
# 默认值：5
# 作用：登船推送成功后，自动保留最近 N 个版本，并顺带清除远端未打标孤立版本 (untagged)
ARK_RETENTION_COUNT=5


# ------------------------------------------------------------------------------
# 10. 推送失败重试次数 (防网络偶发抖动)
# ------------------------------------------------------------------------------
# 默认值：3 (支持指数退避重试: 3s, 6s, 12s)
ARK_PUSH_RETRY=3


# ------------------------------------------------------------------------------
# 11. 构建与推送完成后本地自动清理策略 (节省 VPS 磁盘)
# ------------------------------------------------------------------------------
# ARK_CLEAN_AFTER_PUSH=true: 推送完成后清理临时文件
ARK_CLEAN_AFTER_PUSH=true

# ARK_CLEAN_ALL_AFTER_PUSH=true: 小磁盘极致干净模式，连同 cache/ 缓存集装箱也清空，恢复 0 字节初始状态
# ARK_CLEAN_ALL_AFTER_PUSH=true


# ------------------------------------------------------------------------------
# 12. 固定 Tag 覆盖模式 (解决如阿里云个人版无自动清理 Tag 问题)
# ------------------------------------------------------------------------------
# 默认留空: 采用时间戳标签 {category}-{timestamp} 并按配额维护历史版本
# 若设置为固定值 (例如 "latest" 或 "backup"):
#   - 每次备份将直接推送到该固定 Tag，自动覆写前一次备份
#   - 远端仅保留最新一份数据，无需额外清理历史 Tag
# 命令行可随时使用参数临时覆盖: ark board --latest 或 ark board latest
# ARK_TAG="latest"

