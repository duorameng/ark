# ==============================================================================
#                      ⚓ Ark 班轮货运管理终端 - 部署配置环境样例
# ==============================================================================
# 使用说明：
# 1. 复制本文件重命名为 .env : cp .env.example .env
# 2. 根据您的部署环境填写以下参数
# 3. .env 文件已自动加入 .gitignore，不会被上传或泄露
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GitHub 个人访问凭证 (必填，用于推送镜像及航次配额轮转)
# ------------------------------------------------------------------------------
# 获取方式：GitHub 网页 -> Settings -> Developer settings -> Personal access tokens
# 权限要求：必须勾选以下 3 项权限:
#   - write:packages  (用于推送镜像至 ghcr.io)
#   - read:packages   (用于拉取镜像还原货物)
#   - delete:packages (用于自动轮转清理过期的历史备份镜像)
GH_TOKEN="ghp_YourGitHubPersonalAccessTokenHere123456"

# 备用名称 (若系统中已有 GITHUB_TOKEN 也可自动识别)
# GITHUB_TOKEN="ghp_YourGitHubPersonalAccessTokenHere123456"


# ------------------------------------------------------------------------------
# 2. 货运安全封条口令/密钥 (可选，用于跨机器免交互加解密)
# ------------------------------------------------------------------------------
# 说明：
# - 若配置了此项，所有加解密将优先使用此口令，跨机器部署无需拷贝 keys/seal.key
# - 若留空，Ark 会优先读取本地 keys/seal.key 或在首次运行时通过 ark keygen 生成
ARK_SEAL_KEY="MyStrongVoyageSecret2026!#"


# ------------------------------------------------------------------------------
# 3. 目标镜像仓库地址 (可选，覆盖 config.json 中的 repository)
# ------------------------------------------------------------------------------
# 默认值：ghcr.io/duorameng/ark
# 格式：[注册表域名]/[用户名或组织名]/[仓库名]
ARK_REPOSITORY="ghcr.io/duorameng/ark"

# 别名形式 (与 ARK_REPOSITORY 等效)
# ARK_IMAGE="ghcr.io/duorameng/ark"


# ------------------------------------------------------------------------------
# 4. 镜像推送失败重试配额 (可选，防网络偶发抖动与 GHCR 超时)
# ------------------------------------------------------------------------------
# 默认值：3
# 支持指数退避重试 (初次间隔 3s，逐次翻倍，上限 15s)
ARK_PUSH_RETRY=3


# ------------------------------------------------------------------------------
# 5. 构建推送完成后本地自动清理策略 (可选，大幅节省宿主机存储)
# ------------------------------------------------------------------------------
# 默认值：true (或 1)
# 作用：docker push 成功后，自动删除本地镜像、清理悬空层与 BuildKit 缓存
# 若调试时希望保留本地镜像，可设为 false (或 0)
ARK_CLEAN_AFTER_PUSH=true


# ------------------------------------------------------------------------------
# 6. 推送完成后全量自动重置 (可选，适合小磁盘极致干净模式)
# ------------------------------------------------------------------------------
# 默认值：false (或 0)
# 作用：docker push 成功后，连同 cache/ 缓存集装箱也彻底清空，完全恢复 0 字节初始状态
# ARK_CLEAN_ALL_AFTER_PUSH=true


# ------------------------------------------------------------------------------
# 7. 待备份目录路径 (可选，直接通过 .env 指定备份总目录，免配置 config.json)
# ------------------------------------------------------------------------------
# 说明：
# - 支持配置单个目录: ARK_BACKUP_DIR="/root/workspace" 或 "./test_data"
# - 支持配置多个目录(逗号分隔): ARK_BACKUP_DIR="/data/web, /data/db"
# - 配置后执行 ark board 将直接自动备份此目录，执行 ark scan 亦默认以此为目标
# - 若 config.json 中有 sources，亦可在 path 中使用 ${ARK_BACKUP_DIR} 动态展开
ARK_BACKUP_DIR="/root/workspace"


# ------------------------------------------------------------------------------
# 8. 默认货物恢复落地路径 (可选，执行 ark land / unpack 时默认解封落地目录)
# ------------------------------------------------------------------------------
# 说明：
# - 若配置了此项，运行 ark land 或 ark unpack 未传恢复路径时，将默认原位展开至该路径
# - 命令行传入具体路径 (如 ark land vps /my/path 或 -o /my/path) 时优先于此配置
# ARK_RESTORE_DIR="/root/workspace"


# ------------------------------------------------------------------------------
# 9. 备份保留个数配额 (可选，控制同分类下历史版本保留数量)
# ------------------------------------------------------------------------------
# 默认值：5
# 作用：登船推送成功后，自动保留最近 N 个版本，超出自动归档淘汰旧航次；
#       并顺带扫描清理远端注册表中由于轮转产生的孤立未打标版本 (untagged)
ARK_RETENTION_COUNT=5
